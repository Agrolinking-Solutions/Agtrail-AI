# ── Database ──────────────────────────────────────────
SECRET_KEY=local-dev-secret-key-change-in-prod
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=agtrail_ai
POSTGRES_USER=agtrail
POSTGRES_PASSWORD=changeme

# ── Backend ───────────────────────────────────────────
SECRET_KEY=changeme-generate-a-real-secret
ENVIRONMENT=development
DEBUG=true
ALLOWED_ORIGINS=http://localhost:3000

# ── Cloud Storage (GCP) ───────────────────────────────
GCP_PROJECT_ID=your-gcp-project-id
GCP_BUCKET_NAME=agtrail-farm-images
GOOGLE_APPLICATION_CREDENTIALS=./infra/gcp/service-account.json

# ── AgTrail Integration ───────────────────────────────
AGTRAIL_API_BASE_URL=https://api.agtrail.com
AGTRAIL_API_KEY=changeme

# ── ML ────────────────────────────────────────────────
MODEL_VERSION=v1
MODEL_PATH=./backend/ml/models
MLFLOW_TRACKING_URI=http://localhost:5000
