# Copy to backend/.env and fill in. The backend always reads this file,
# wherever it is started from. Never commit the real .env.

# ── App ───────────────────────────────────────────────
ENVIRONMENT=development          # set to production in production, enables startup safety checks
ENABLE_DOCS=false
LOG_LEVEL=INFO
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Comma separated
ALLOWED_ORIGINS=http://localhost:3000
# Comma separated label:key pairs for callers of /predictions.
# Generate each key with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEYS=dashboard:

# ── Database ──────────────────────────────────────────
# Either a full connection string...
DATABASE_URL=
# ...or the individual parts (used only when DATABASE_URL is empty).
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DB=agtrail_ai
POSTGRES_USER=agtrail
POSTGRES_PASSWORD=
DB_SSL_MODE=require              # use disable only for a local database container

# ── AgTrail Integration ───────────────────────────────
AGTRAIL_API_BASE_URL=https://agtrail-backend-v2-production.up.railway.app
AGTRAIL_WEBHOOK_SECRET=
# Separate key for requests we sign to AgTrail. Empty = reuse webhook secret.
AGTRAIL_OUTBOUND_SECRET=
WEBHOOK_MAX_BODY_BYTES=262144

# ── Satellite imagery (farms/ endpoints) ─────────────
# Copernicus Data Space OAuth client, for NDVI (Sentinel-2)
# ── Knowledge Base ────────────────────────────────────
# Crop rules and shared reference data (read-only, no key needed).
KNOWLEDGE_BASE_URL=https://validation.agrolinking.com

# ── PIS ───────────────────────────────────────────────
# Commodity prices, 30-day outlook and weather (read-only, no key needed).
PIS_API_URL=https://pis-api.agrolinking.com

CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=
# Mapbox Static Images API, for the mapbox/mapbox-area styles
MAPBOX_ACCESS_TOKEN=

# ── Image fetching ────────────────────────────────────
IMAGE_MAX_BYTES=15728640
IMAGE_MAX_PIXELS=40000000
IMAGE_ALLOW_HTTP=false
CONTACT_EMAIL=                   # sent in the User-Agent when fetching images

# ── ML ────────────────────────────────────────────────
MIN_PREDICTION_CONFIDENCE=0.5
MLFLOW_TRACKING_URI=http://localhost:5000

# ── Image archive ─────────────────────────────────────
# Monitoring photos are copied here so they outlive AgTrail's own URLs.
# Archive to our own S3-compatible bucket on the VPS (Garage). Set all five S3_ values
# (the secret never goes in git or chat). Google Cloud Storage below is only the fallback.
# Leave both buckets empty to turn archiving off (no archive jobs are queued).
S3_ENDPOINT=
S3_REGION=garage
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
GCP_PROJECT_ID=
GCP_BUCKET_NAME=
GOOGLE_APPLICATION_CREDENTIALS=
